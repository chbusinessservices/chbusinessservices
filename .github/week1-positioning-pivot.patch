+import { useState } from "react";
+import { Link, createFileRoute } from "@tanstack/react-router";
+import { createServerFn } from "@tanstack/react-start";
+import { AnimatedSection } from "~/components/AnimatedSection";
+import { useToast } from "~/components/Toast";
+import { sql } from "~/db";
+import { pageHead } from "~/lib/seo";
+
+export const Route = createFileRoute("/offers/profit-leak-scan")({
+  head: () =>
+    pageHead({
+      title: "Free Profit Leak Scan | CH Business Services",
+      description:
+        "Find the hidden leaks costing your business money. Free 7-day Profit Leak Scan for plumbing companies — Profit Health Score, ranked leak map, and the next action worth taking.",
+      path: "/offers/profit-leak-scan",
+    }),
+  component: ProfitLeakScan,
+});
+
+/* ─── Server function for scan submissions ─── */
+
+const submitProfitLeakScan = createServerFn().handler(
+  async (payload: {
+    businessName: string;
+    email: string;
+    phone: string;
+    serviceType: string;
+    revenueRange: string;
+  }) => {
+    const { businessName, email, phone, serviceType, revenueRange } = payload;
+
+    if (!businessName || !email || !serviceType) {
+      throw new Error("Business name, email, and service type are required.");
+    }
+
+    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+    if (!emailRegex.test(email)) {
+      throw new Error("Please enter a valid email address.");
+    }
+
+    const client = sql();
+    await client`
+      CREATE TABLE IF NOT EXISTS profit_leak_scans (
+        id SERIAL PRIMARY KEY,
+        business_name TEXT NOT NULL,
+        email TEXT NOT NULL,
+        phone TEXT,
+        service_type TEXT NOT NULL,
+        revenue_range TEXT,
+        status TEXT NOT NULL DEFAULT 'new',
+        created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+      )
+    `;
+    await client`
+      INSERT INTO profit_leak_scans (business_name, email, phone, service_type, revenue_range)
+      VALUES (${businessName}, ${email}, ${phone || null}, ${serviceType}, ${revenueRange || null})
+    `;
+
+    return { success: true };
+  },
+);
+
+function CheckItem({ text }: { text: string }) {
+  return (
+    <li className="flex items-start gap-3">
+      <svg className="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
+      </svg>
+      <span className="text-gray-700">{text}</span>
+    </li>
+  );
+}
+
+function ScanForm() {
+  const [submitted, setSubmitted] = useState(false);
+  const [submitting, setSubmitting] = useState(false);
+  const { addToast } = useToast();
+
+  if (submitted) {
